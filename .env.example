# Copy to .env and fill in. Nothing here has a useful default.

# ── Discord ──────────────────────────────────────────────────────────
DISCORD_TOKEN=
# Where new dev tasks get announced. A forum channel is recommended once
# there are more than a handful of open issues: one post per issue, with
# GitHub labels mapped onto forum tags, is searchable and filterable in a
# way a scrolling text channel is not.
DEV_ANNOUNCE_CHANNEL_ID=

# Your server's id. Set it: a global command sync takes up to an hour to
# reach clients, so a renamed command keeps showing under its old name and
# looks broken. A guild sync is immediate.
# Which forum tag to fall back on when an issue has no labels that match.
# Only consulted when the forum is set to require a tag — without it, an
# unlabelled issue cannot be posted at all. Empty means "the first tag".
DEFAULT_FORUM_TAG=

DISCORD_GUILD_ID=

# ── GitHub ───────────────────────────────────────────────────────────
# The bot's own account. Used to open issues and to post comments for people
# who have not run /github-login. `public_repo` is enough for an open project;
# a private one needs `repo`.
GITHUB_BOT_TOKEN=
# Default target for /start-dev when no repo is given.
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# ── GitHub OAuth ─────────────────────────────────────────────────────
# So that a comment made in Discord appears on GitHub under the name of the
# person who typed it, rather than the bot's. Without these, /github-login
# refuses and everything falls back to the bot's identity.
#
# Register at https://github.com/settings/developers with the callback below.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://your.host/github/callback

# ── GitHub webhook ───────────────────────────────────────────────────
# Set the same value in the repository's webhook settings, with the payload URL
# pointing at https://your.host/github/webhook and the `issues` and
# `issue_comment` events selected.
#
# Without this, GitHub comments do not reach Discord — the sync becomes
# one-directional and nothing says so.
GITHUB_WEBHOOK_SECRET=

# ── HTTP ─────────────────────────────────────────────────────────────
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# ── Optional: Docker watching ────────────────────────────────────────
# Leave WATCH_CONTAINER empty and the whole Docker cog stays unloaded.
WATCH_CONTAINER=
# Where container status and error logs are posted.
TARGET_CHANNEL_ID=
# The restart button. Needs the socket proxy to allow POST as well; read the
# comment in docker-compose.yml before turning this on.
ALLOW_RESTART=

# ── Mermaid ──────────────────────────────────────────────────────────
# Where to render ```mermaid fences. docker-compose sets this for you; leave it
# blank and diagrams arrive in Discord as source rather than as pictures.
#
# Point it somewhere public (https://mermaid.ink) only if you do not mind that
# service seeing every diagram in the repository.
MERMAID_URL=

# The mermaid theme, and the colour behind it. The defaults match Discord's dark
# message background so a diagram reads as part of the message. `bgColor` is not
# optional in spirit: the renderer's default output is transparent, and dark
# strokes on a transparent background are invisible on a dark client.
MERMAID_THEME=dark
MERMAID_BACKGROUND=313338

# ── Misc ─────────────────────────────────────────────────────────────
DATA_DIR=data
LOG_LEVEL=INFO
